#	A Makefile to compile general-purpose C code for the RadPC Hydra board
#
#--------------------------------------------------------------------------------------------------------------------------------------


##--------------------------------------------------------------------------------------------------------------------------------------
##	VARIABLES
##--------------------------------------------------------------------------------------------------------------------------------------

# Target for the binaries
TARGET = main

# Compiler (RISC-V RV32I)
SUITE = riscv32-unknown-elf
ARCH = -march=rv32i -mabi=ilp32
CC = $(SUITE)-gcc $(ARCH)
CSIZE = $(SUITE)-size
COBJDUMP = $(SUITE)-objdump
MAP = reports/$(TARGET).map

# RadPC Installation Directory
INSTALL_DIR = /opt/radpc

# Directories for RadPC drivers and libraries
CODEDIRS = . $(INSTALL_DIR)/drivers/lib
INCDIRS = . $(INSTALL_DIR)/drivers/include/

# Directory for RadPC linker
LINKER = $(INSTALL_DIR)/arch/radpc.ld

# Optimization
# Optimization is set to -O0 by default
OPT = -O0

# Dependency Flags
DEPFLAGS = -MP -MD

# Compiler Flags
CFLAGS = -Wall -ffreestanding $(foreach D, $(INCDIRS), -I$(D)) $(OPT) $(DEPFLAGS) -fdata-sections -ffunction-sections

# C Files, Assembly S Files, Objects, Dependencies
SFILES = $(foreach D, $(CODEDIRS), $(wildcard $(D)/*.S ) )
CFILES = $(foreach D, $(CODEDIRS), $(wildcard $(D)/*.c ) )

OBJECTS = $(patsubst %.S, %.o, $(SFILES) )
OBJECTS += $(patsubst %.c, %.o, $(CFILES) )

DEPFILES = $(patsubst %.c, %.d, $(CFILES) )


##--------------------------------------------------------------------------------------------------------------------------------------
##	BUILD RULES (GENERAL)
##--------------------------------------------------------------------------------------------------------------------------------------

# Build All
all: clean build_bin


##--------------------------------------------------------------------------------------------------------------------------------------
##	BUILD RULES (SPECIFIC CONFIGURATIONS)
##--------------------------------------------------------------------------------------------------------------------------------------

# Build for RadPC bootloadable binary
build_bin: $(TARGET)

	@$(CSIZE) -A -x $^
	@rm -rf reports/disassembly.txt
	@$(COBJDUMP) --disassemble $^ >> reports/disassembly.txt
	@rm -rf $(OBJECTS) $(DEPFILES) lib/crt0.d


##--------------------------------------------------------------------------------------------------------------------------------------
##	BUILD RULES (GENERIC)
##--------------------------------------------------------------------------------------------------------------------------------------

# Generic target compilation rule
$(TARGET): $(OBJECTS)
	$(CC) -nostdlib -Wl,--no-relax -T $(LINKER) -Wl,-Map=$(MAP) -Wl,--gc-sections,--undefined=main,--undefined=interrupt -o $@ $^ 


# Generic rule for all C files
%.o: %.c
	$(CC) $(CFLAGS) -c -o $@ $^ 


##--------------------------------------------------------------------------------------------------------------------------------------
##	BUILD RULES (CLEAN)
##--------------------------------------------------------------------------------------------------------------------------------------

# Clean rule
clean:
	rm -rf $(TARGET) $(OBJECTS) $(DEPFILES) $(INSTALL_DIR)/drivers/lib/*.d $(INSTALL_DIR)/drivers/lib/*.o


##--------------------------------------------------------------------------------------------------------------------------------------
##	ERROR RESOLUTIONS
##--------------------------------------------------------------------------------------------------------------------------------------

# Include all dependencies
-include $(DEPFILES)

# Add .PHONY so that way rules still work even if there are name conflicts
.PHONY: all clean


##--------------------------------------------------------------------------------------------------------------------------------------
##	END OF CODE
##--------------------------------------------------------------------------------------------------------------------------------------